def init_db():
    conn = sqlite3.connect('uno_history.db')
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            input_text TEXT,
            key_code TEXT,
            shift_pattern TEXT,
            result_text TEXT
        )
    ''')
    conn.commit()
    conn.close()
